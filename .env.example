# ──────────────────────────────────────────────────────────────────────────────
# ComfyDesk — Environment Variables
# Copy to .env and adjust values for your environment
# ──────────────────────────────────────────────────────────────────────────────

# ── Paths (host paths, mounted into containers) ────────────────────────────
COMFYUI_MODELS_DIR=./volumes/models
COMFYUI_OUTPUT_DIR=./volumes/output
HF_CACHE_DIR=./volumes/hf_cache
DATASET_DIR=./volumes/dataset

# ── Ports ──────────────────────────────────────────────────────────────────
NGINX_PORT=80
COMFYUI_PORT=8188
JOYCAPTION_PORT=9001

# ── Gateway settings ────────────────────────────────────────────────────────
COMFYUI_URL=http://comfyui:8188
JOYCAPTION_URL=http://joycaption:8000
# Optional: API key for gateway authentication (leave empty to disable)
GATEWAY_API_KEY=

# ── JoyCaption model ────────────────────────────────────────────────────────
# Swap model if needed, e.g. fancyfeast/llama-joycaption-alpha-two-hf
JOYCAPTION_MODEL=fancyfeast/llama-joycaption-beta-one-hf-llava
JOYCAPTION_MAX_MODEL_LEN=4096
# GPU fraction for JoyCaption (rest goes to ComfyUI)
JOYCAPTION_GPU_UTIL=0.45

# ── Hugging Face ────────────────────────────────────────────────────────────
# Set if needed for gated model access
HF_TOKEN=

# ── Next.js frontend (local dev) ───────────────────────────────────────────
NEXT_PUBLIC_API_BASE=http://localhost/api/v1

# ── Studio Agent (LLM brain, OpenAI-compatible) ────────────────────────────
# Any OpenAI-compatible provider works (DeepSeek/GLM/DashScope/vLLM/…)
AGENT_LLM_BASE_URL=https://api.deepseek.com/v1
AGENT_LLM_API_KEY=
AGENT_LLM_MODEL=deepseek-chat
# Offline mock brain for testing without a key (1 = enabled)
AGENT_LLM_MOCK=
GPU_IDLE_UNLOAD_SEC=600
