[Unit]
Description=ComfyDesk FastAPI gateway :8001
After=network-online.target comfydesk-comfyui.service
Wants=network-online.target

[Service]
User=anse10rville
WorkingDirectory=/data/git_repository/comfy-desk/gateway
ExecStart=/data/git_repository/comfy-desk/.venv/bin/python -m uvicorn main:app --host 0.0.0.0 --port 8001
Restart=always
RestartSec=5
Environment=COMFYUI_URL=http://localhost:8188
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
